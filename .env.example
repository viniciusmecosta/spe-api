PROJECT_NAME="SPE - Sistema de Ponto Eletrônico"
API_V1_STR="/api/v1"
TIMEZONE="America/Fortaleza"
POSTGRES_DB="spe_db"
POSTGRES_USER="spe_user"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
SQLALCHEMY_DATABASE_URI="postgresql+asyncpg://spe_user:your_postgres_password@localhost:5432/spe_db"
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
FIRST_SUPERUSER=""
FIRST_SUPERUSER_PASSWORD=""
UPLOAD_DIR="uploads"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""
APP_VERSION="1.2.0"
ENVIRONMENT="PROD"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

ROUTINE_LOG_RETENTION_DAYS=15
DAILY_REPORT_HOUR=9
HOURLY_BACKUP_START_HOUR=6
HOURLY_BACKUP_END_HOUR=19
BACKEND_CORS_ORIGINS='["*"]'
TELEGRAM_MAX_MESSAGE_LENGTH=3900
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=15
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=120000
DB_LOCK_TIMEOUT_MS=10000
DB_IDLE_TRANSACTION_TIMEOUT_MS=60000
REPROCESS_MAX_DAYS=3660
REPROCESS_MAX_ITEMS=100000
REPROCESS_BATCH_SIZE=25
BACKGROUND_JOBS_ENABLED=true
